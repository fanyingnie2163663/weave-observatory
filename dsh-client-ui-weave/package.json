{
  "name": "dsh-client-ui-weave",
  "version": "0.1.0",
  "description": "把 Weave 织造观测台做成 DSH Web 会话视图：可暂停、可回拉的多智能体协作观测界面。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "observability",
    "multi-agent",
    "ui",
    "replay"
  ],
  "author": "fanyingnie",
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanyingnie2163663/weave-observatory.git",
    "directory": "dsh-client-ui-weave"
  },
  "homepage": "https://github.com/fanyingnie2163663/weave-observatory/tree/main/dsh-client-ui-weave"
}
